map:s_000 rdf:type rr:SubjectMap ;
	rr:constant "https://example.org/id/dataset/hamburg-verkeersmetingen" .

map:s_001 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/verkeerstelling/{observation['@iot.id']}" .

map:s_002 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/verkeerstellingkenmerk/{observation['@iot.id']}" .

map:s_003 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/verkeersmeetpunt/{thing['@iot.id']}" .

map:s_004 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/rijrichting/{datastream['@iot.id']}" .

map:s_005 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/geometrie/{thing['@iot.id']}" .

map:s_006 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/sensor/{sensor['@iot.id']}" .

map:s_007 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/tijdsinterval/{observation['@iot.id']}" .

map:s_008 rdf:type rr:SubjectMap ;
	rr:template "https://example.org/id/tijdsinterval/{observation['@iot.id']}/begin" .

